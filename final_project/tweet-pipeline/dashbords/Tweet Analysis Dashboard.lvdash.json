    {
      "name": "efb7d3c7",
      "displayName": "Total Tweets Ingested",
      "queryLines": [
        "SELECT COUNT(*) AS total_tweets\n",
        "FROM tweets_bronze;"
      ]
    },
    {
      "name": "67c4a0e4",
      "displayName": "Tweets with Mentions",
      "queryLines": [
        "SELECT COUNT(*) AS tweets_with_mentions\n",
        "FROM tweets_silver\n",
        "WHERE mention IS NOT NULL;"
      ]
    },
    {
      "name": "04042a0a",
      "displayName": "Tweets without Mentions",
      "queryLines": [
        "SELECT COUNT(*) AS tweets_without_mentions\n",
        "FROM tweets_silver\n",
        "WHERE mention IS NULL;"
      ]
    },
    {
      "name": "2fd5bce5",
      "displayName": "Top 10 Users by Tweet Count",
      "queryLines": [
        "SELECT\n",
        "  user,\n",
        "  COUNT(*) AS tweet_count\n",
        "FROM tweets_bronze\n",
        "GROUP BY user\n",
        "ORDER BY tweet_count DESC, user ASC\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "ed12f4db",
      "displayName": "Top 10 Most Positively Mentioned",
      "queryLines": [
        "SELECT\n",
        "  mention,\n",
        "  positive - negative AS positive_net\n",
        "FROM gold_tweet_aggregations\n",
        "WHERE positive > negative\n",
        "ORDER BY positive_net DESC, mention ASC\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "58c35b34",
      "displayName": "Top 10 Most Negatively Mentioned",
      "queryLines": [
        "SELECT\n",
        "  mention,\n",
        "  negative - positive AS negative_net\n",
        "FROM gold_tweet_aggregations\n",
        "WHERE negative > positive\n",
        "ORDER BY negative_net DESC, mention ASC\n",
        "LIMIT 10;"
      ]
    }
  ],
